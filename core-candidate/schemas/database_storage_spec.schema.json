{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_storage_spec.schema.json",
  "title": "GRDR database snapshot storage specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_slug", "snapshot_id", "core", "source_repository", "release", "elements_root", "observation_inputs", "adapter_inputs", "runtime"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "source_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repository"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"}
      }
    },
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "local_path", "visibility"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "local_path": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "title"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "elements_root": {"type": "string", "minLength": 1},
    "observation_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "adapter_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "files"],
      "properties": {
        "descriptor": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
