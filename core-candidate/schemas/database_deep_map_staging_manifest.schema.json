{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_staging_manifest.schema.json",
  "title": "GRDR database deep-map execution staging manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_id", "state", "records", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "state": {"enum": ["open", "sealed", "archived"]},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "registry_file", "action", "base_fingerprint", "staged_fingerprint", "staged_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"},
          "registry_file": {"enum": ["institutions.jsonl", "sources.jsonl", "datasets.jsonl", "data_structures.jsonl", "resources.jsonl", "data_elements.jsonl", "variables.jsonl", "constructs.jsonl", "relationships.jsonl", "adapters.jsonl", "storage.jsonl", "monitors.jsonl", "source_profiles.jsonl", "semantic_nodes.jsonl"]},
          "action": {"enum": ["create", "update", "unchanged"]},
          "base_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "staged_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "staged_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
