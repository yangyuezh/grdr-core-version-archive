{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/construct.schema.json",
  "title": "GRDR construct record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "definition", "domains", "construct_type", "verification", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:construct:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "definition": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "construct_type": {"enum": ["physical_quantity", "biological_property", "behavior", "subjective_state", "social_or_institutional", "economic", "environmental", "computed_or_formal", "other"]},
    "broader_construct_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:construct:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "scope_notes": {"type": ["string", "null"]},
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {"enum": ["official_definition", "standard", "controlled_vocabulary", "peer_reviewed_definition", "other"]},
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "archived_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
