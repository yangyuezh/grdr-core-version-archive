{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/research_request.schema.json",
  "title": "GRDR research request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "question", "inference_goal"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inference_goal": {
      "enum": ["descriptive", "predictive", "causal", "mechanistic", "exploratory", "benchmarking", "mixed", "unknown"]
    },
    "target_population": {"type": ["string", "null"]},
    "unit_of_analysis": {"type": ["string", "null"]},
    "spatial_scope": {"type": ["string", "null"]},
    "temporal_scope": {"type": ["string", "null"]},
    "constructs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "proposed_role", "status"],
        "properties": {
          "name": {"type": "string"},
          "proposed_role": {
            "enum": ["outcome", "exposure", "confounder", "mediator", "moderator", "instrument", "selection", "validation", "context", "unknown"]
          },
          "status": {"enum": ["user_specified", "agent_proposed", "unresolved"]},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "data_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_modalities": {"type": "array", "items": {"type": "string"}},
        "prohibited_modalities": {"type": "array", "items": {"type": "string"}},
        "objective_subjective": {"enum": ["objective", "subjective", "both", "unspecified"]},
        "microdata_required": {"type": ["boolean", "null"]}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open_data_only": {"type": ["boolean", "null"]},
        "registration_allowed": {"type": ["boolean", "null"]},
        "commercial_data_allowed": {"type": ["boolean", "null"]},
        "sensitive_data_allowed": {"type": ["boolean", "null"]},
        "languages": {"type": "array", "items": {"type": "string"}},
        "compute_notes": {"type": ["string", "null"]},
        "other": {"type": ["string", "null"]}
      }
    }
  }
}
