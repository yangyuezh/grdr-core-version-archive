{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/dataset.schema.json",
  "title": "GRDR dataset record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "source_ids",
    "description",
    "scope",
    "release",
    "methodology",
    "resource_ids",
    "verification",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:dataset:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disciplines", "topics", "population", "observation_units", "geographic_coverage", "spatial_resolution", "temporal_coverage", "temporal_resolution", "modalities"],
      "properties": {
        "disciplines": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "population": {"type": ["string", "null"]},
        "observation_units": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "geographic_coverage": {"type": ["string", "null"]},
        "spatial_resolution": {"type": ["string", "null"]},
        "temporal_coverage": {"type": ["string", "null"]},
        "temporal_resolution": {"type": ["string", "null"]},
        "modalities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_version", "release_date", "update_frequency", "revision_policy_known", "historical_vintages_available"],
      "properties": {
        "current_version": {"type": ["string", "null"]},
        "release_date": {"type": ["string", "null"], "format": "date"},
        "update_frequency": {"type": ["string", "null"]},
        "revision_policy_known": {"type": ["boolean", "null"]},
        "historical_vintages_available": {"type": ["boolean", "null"]}
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_generating_processes", "harmonization", "modeled_estimates", "methodology_url", "limitations"],
      "properties": {
        "data_generating_processes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "harmonization": {"enum": ["none", "within_source", "cross_source", "mixed", "unknown"]},
        "modeled_estimates": {"enum": ["none", "some", "all", "unknown"]},
        "methodology_url": {"type": ["string", "null"], "format": "uri"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resource_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^grdr:resource:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_citation": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]},
        "citation_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {"enum": ["official_catalog", "official_methodology", "official_documentation", "data_paper", "peer_reviewed_validation", "citation_guidance", "license", "other"]},
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "archived_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
