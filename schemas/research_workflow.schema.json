{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/research_workflow.schema.json",
  "title": "GRDR research project workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "workflow_status", "current_step", "matching_attempt", "gap_expansion_round", "last_operation", "next_actions", "history", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project_id": {"type": "string", "pattern": "^grdr:research-project:[a-z0-9][a-z0-9-]*$"},
    "workflow_status": {"enum": ["initialized", "awaiting_human", "ready_to_match", "matched", "gaps_identified", "expansion_planned", "completed", "blocked"]},
    "current_step": {"enum": ["indicator_scaffold", "human_gate", "matching", "gap_analysis", "source_expansion", "rematching", "completed"]},
    "matching_attempt": {"type": "integer", "minimum": 0},
    "gap_expansion_round": {"type": "integer", "minimum": 0},
    "last_operation": {"type": ["string", "null"]},
    "next_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "operation", "summary"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "operation": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
