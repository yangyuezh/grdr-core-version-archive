{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_stage_update.schema.json",
  "title": "GRDR database deep-map unit stage update",
  "type": "object", "additionalProperties": false,
  "required": ["unit_id", "stage", "state", "expected_count", "registered_ids", "verified_count", "completion_basis", "evidence", "blockers", "notes"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^grdr:deep-map-unit:[a-z0-9][a-z0-9-]*$"},
    "stage": {"enum": ["dataset", "data_structure", "data_element", "variable", "construct", "access"]},
    "state": {"enum": ["not_started", "enumerating", "in_progress", "mapped_complete", "verified_complete", "not_applicable", "blocked"]},
    "expected_count": {"type": ["integer", "null"], "minimum": 0},
    "registered_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "verified_count": {"type": "integer", "minimum": 0},
    "completion_basis": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["url", "title", "evidence_type", "supports", "retrieved_at"], "properties": {"url": {"type": "string", "format": "uri"}, "title": {"type": "string", "minLength": 1}, "evidence_type": {"type": "string", "minLength": 1}, "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "retrieved_at": {"type": "string", "format": "date-time"}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["type", "notes"], "properties": {"type": {"enum": ["access", "authentication", "payment", "license", "privacy", "ethics", "technical", "scale", "missing_metadata", "other"]}, "notes": {"type": "string", "minLength": 1}}}
  }
}
