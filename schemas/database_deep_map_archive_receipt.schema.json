{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_archive_receipt.schema.json",
  "title": "GRDR canonical database archive receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_id", "package_fingerprint", "registry_version", "created_count", "updated_count", "unchanged_count", "collection_counts", "registry_validation", "catalog_validation", "archived_at", "receipt_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "package_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registry_version": {"type": "string", "minLength": 1},
    "created_count": {"type": "integer", "minimum": 0},
    "updated_count": {"type": "integer", "minimum": 0},
    "unchanged_count": {"type": "integer", "minimum": 0},
    "collection_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "registry_validation": {"type": "string", "minLength": 1},
    "catalog_validation": {"type": "string", "minLength": 1},
    "archived_at": {"type": "string", "format": "date-time"},
    "receipt_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
