{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/invocation_acceptance_audit.schema.json",
  "title": "GRDR Core-to-source Runtime invocation acceptance audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "snapshot_id", "status", "registered_variable_count", "probe_count", "probes", "tested_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "status": {"const": "ready"},
    "registered_variable_count": {"type": "integer", "minimum": 0},
    "probe_count": {"type": "integer", "minimum": 0},
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "variable_id", "route_policy", "parameters", "selected_route", "selected_route_id", "row_count", "output_file_count", "output_content_fingerprint", "status"],
        "properties": {
          "probe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "variable_id": {"type": "string", "pattern": "^grdr:variable:[a-z0-9][a-z0-9-]*$"},
          "route_policy": {"enum": ["latest", "reproducible", "offline"]},
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "country": {"type": "string", "minLength": 1},
              "start_period": {"type": "string", "minLength": 1},
              "end_period": {"type": "string", "minLength": 1},
              "timeout": {"type": "integer", "minimum": 1}
            },
            "minProperties": 1
          },
          "selected_route": {"enum": ["official_upstream", "github_release_snapshot", "local_snapshot_cache", "elements_mirror", "mounted_object_store"]},
          "selected_route_id": {"type": "string", "minLength": 1},
          "row_count": {"type": "integer", "minimum": 0},
          "output_file_count": {"type": "integer", "minimum": 1},
          "output_content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"const": "passed"}
        }
      }
    },
    "tested_at": {"type": "string", "format": "date-time"}
  }
}
