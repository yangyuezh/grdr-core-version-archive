{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/online_runtime_audit.schema.json",
  "title": "GRDR source runtime online-access audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "snapshot_id",
    "status",
    "variable_count",
    "online_callable_variable_count",
    "unresolved_online_variable_count",
    "route_results",
    "variable_routes",
    "tested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "status": {"const": "ready"},
    "variable_count": {"type": "integer", "minimum": 0},
    "online_callable_variable_count": {"type": "integer", "minimum": 0},
    "unresolved_online_variable_count": {"const": 0},
    "route_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "status", "access_method", "authority", "tested_at", "evidence_basis"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "status": {"const": "ready"},
          "access_method": {"enum": ["official_api", "official_bulk_download", "official_browser_automation", "grdr_release_snapshot"]},
          "authority": {"enum": ["official", "grdr"]},
          "tested_at": {"type": "string", "format": "date-time"},
          "evidence_basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "variable_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variable_id", "route_ids"],
        "properties": {
          "variable_id": {"type": "string", "pattern": "^grdr:variable:[a-z0-9][a-z0-9-]*$"},
          "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
        }
      }
    },
    "tested_at": {"type": "string", "format": "date-time"}
  }
}
