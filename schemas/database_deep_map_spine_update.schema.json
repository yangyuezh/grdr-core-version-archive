{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_spine_update.schema.json",
  "title": "GRDR dual-spine unit update",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "spine", "state", "expected_node_count", "node_ids", "verified_node_count", "expected_edge_count", "edge_ids", "verified_edge_count", "root_node_ids", "leaf_node_ids", "topology_fingerprint", "completion_basis", "evidence", "blockers", "checkpoint"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^grdr:deep-map-unit:[a-z0-9][a-z0-9-]*$"},
    "spine": {"enum": ["structural", "disciplinary", "variable_bridge"]},
    "state": {"enum": ["not_started", "enumerating", "in_progress", "mapped_complete", "verified_complete", "not_applicable", "blocked"]},
    "expected_node_count": {"type": ["integer", "null"], "minimum": 0},
    "node_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "verified_node_count": {"type": "integer", "minimum": 0},
    "expected_edge_count": {"type": ["integer", "null"], "minimum": 0},
    "edge_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:relationship:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "verified_edge_count": {"type": "integer", "minimum": 0},
    "root_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "leaf_node_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "topology_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "completion_basis": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "checkpoint": {"$ref": "#/$defs/checkpoint"}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["url", "title", "evidence_type", "supports", "retrieved_at"], "properties": {"url": {"type": "string", "format": "uri"}, "title": {"type": "string", "minLength": 1}, "evidence_type": {"type": "string", "minLength": 1}, "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "retrieved_at": {"type": "string", "format": "date-time"}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["type", "notes"], "properties": {"type": {"enum": ["access", "authentication", "payment", "license", "privacy", "ethics", "technical", "scale", "missing_metadata", "schema_drift", "semantic_ambiguity", "quality", "other"]}, "notes": {"type": "string", "minLength": 1}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["enumeration_rule", "completed_native_count", "last_native_id", "next_native_id", "snapshot", "cursor_checksum"], "properties": {"enumeration_rule": {"type": ["string", "null"]}, "completed_native_count": {"type": "integer", "minimum": 0}, "last_native_id": {"type": ["string", "null"]}, "next_native_id": {"type": ["string", "null"]}, "snapshot": {"type": ["string", "null"], "format": "date-time"}, "cursor_checksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}}
  }
}
