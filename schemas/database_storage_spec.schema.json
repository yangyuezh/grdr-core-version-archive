{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_storage_spec.schema.json",
  "title": "GRDR database snapshot storage specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_slug", "snapshot_id", "core", "source_repository", "release", "observation_policy", "observation_inputs", "raw_observation_exclusions", "adapter_inputs", "runtime"],
  "properties": {
    "schema_version": {"enum": ["4.0.0", "4.1.0"]},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "source_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "core": {
      "type": "object", "additionalProperties": false, "required": ["version", "repository"],
      "properties": {"version": {"type": "string", "minLength": 1}, "repository": {"type": "string", "format": "uri"}}
    },
    "source_repository": {
      "type": "object", "additionalProperties": false, "required": ["github", "local_path", "visibility"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "local_path": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["tag", "title"],
      "properties": {"tag": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}
    },
    "elements_root": {"type": "string", "minLength": 1, "deprecated": true},
    "observation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replication", "online_access", "cache"],
      "properties": {
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "placements", "completeness", "partition_manifest", "external_locations"],
          "properties": {
            "mode": {"enum": ["full_mirror", "partitioned_mirror", "no_mirror"]},
            "placements": {"type": "array", "uniqueItems": true, "items": {"enum": ["github_release", "elements", "object_store"]}},
            "completeness": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "basis", "expected_file_count", "expected_partition_count"],
              "properties": {
                "claim": {"enum": ["complete_within_knowledge_scope", "complete_declared_partition_set", "observations_not_replicated"]},
                "basis": {"type": "string", "minLength": 1},
                "expected_file_count": {"type": ["integer", "null"], "minimum": 1},
                "expected_partition_count": {"type": ["integer", "null"], "minimum": 1}
              }
            },
            "partition_manifest": {"type": ["string", "null"], "minLength": 1},
            "external_locations": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["type", "uri", "local_path", "verification"],
                "properties": {
                  "type": {"const": "object_store"},
                  "uri": {"type": "string", "format": "uri"},
                  "local_path": {"type": "string", "minLength": 1},
                  "verification": {"const": "copied_and_hashed"}
                }
              }
            },
            "capacity_estimate": {
              "type": ["object", "null"], "additionalProperties": false,
              "required": ["estimated_total_bytes", "basis"],
              "properties": {
                "estimated_total_bytes": {"type": "integer", "minimum": 1},
                "basis": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "online_access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completion_requirement", "official_access", "routes"],
          "properties": {
            "completion_requirement": {"const": "all_registered_variables_online_callable"},
            "official_access": {
              "type": "object", "additionalProperties": false, "required": ["status", "basis"],
              "properties": {
                "status": {"enum": ["callable", "unavailable"]},
                "basis": {"type": "string", "minLength": 1}
              }
            },
            "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}}
          }
        },
        "cache": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "research_project_snapshots", "root"],
          "properties": {
            "mode": {"enum": ["disabled", "on_demand"]},
            "research_project_snapshots": {"type": "boolean"},
            "root": {"enum": [null, "research_project"]}
          }
        }
      }
    },
    "observation_inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "raw_observation_exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "adapter_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["descriptor", "files"],
      "properties": {
        "descriptor": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "acceptance_probes": {
          "type": "array",
          "items": {"$ref": "#/$defs/acceptance_probe"}
        }
      }
    }
  },
  "$defs": {
    "acceptance_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "variable_id", "route_policy", "parameters", "expected"],
      "properties": {
        "probe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "variable_id": {"type": "string", "pattern": "^grdr:variable:[a-z0-9][a-z0-9-]*$"},
        "route_policy": {"enum": ["latest", "reproducible", "offline"]},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "country": {"type": "string", "minLength": 1},
            "start_period": {"type": "string", "minLength": 1},
            "end_period": {"type": "string", "minLength": 1},
            "timeout": {"type": "integer", "minimum": 1}
          },
          "minProperties": 1
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_row_count", "selected_routes"],
          "properties": {
            "minimum_row_count": {"type": "integer", "minimum": 1},
            "selected_routes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["official_upstream", "github_release_snapshot", "local_snapshot_cache", "elements_mirror", "mounted_object_store"]}
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "access_method", "authority", "uri", "freshness", "coverage_claim", "verification"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "access_method": {"enum": ["official_api", "official_bulk_download", "official_browser_automation", "grdr_release_snapshot"]},
        "authority": {"enum": ["official", "grdr"]},
        "uri": {"type": "string", "format": "uri"},
        "freshness": {"enum": ["current_upstream", "version_pinned", "frozen_snapshot"]},
        "coverage_claim": {"enum": ["all_registered_variables", "declared_subset"]},
        "verification": {"enum": ["live_runtime_test", "staged_release_snapshot_test"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "4.0.0"}}},
      "then": {"required": ["elements_root"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "4.1.0"}}},
      "then": {
        "properties": {
          "observation_policy": {
            "properties": {
              "replication": {
                "properties": {
                  "placements": {"not": {"contains": {"const": "elements"}}}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication": {"properties": {"mode": {"const": "full_mirror"}}}}}}},
      "then": {"properties": {
        "observation_inputs": {"minItems": 1},
        "observation_policy": {"properties": {"replication": {"properties": {
          "placements": {"minItems": 1},
          "completeness": {"properties": {"claim": {"const": "complete_within_knowledge_scope"}, "expected_file_count": {"type": "integer", "minimum": 1}, "expected_partition_count": {"type": "null"}}},
          "partition_manifest": {"type": "null"}
        }}}}
      }}
    },
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication": {"properties": {"mode": {"const": "partitioned_mirror"}}}}}}},
      "then": {"properties": {
        "observation_inputs": {"minItems": 1},
        "observation_policy": {"properties": {"replication": {"properties": {
          "placements": {"minItems": 1},
          "completeness": {"properties": {"claim": {"const": "complete_declared_partition_set"}, "expected_file_count": {"type": "integer", "minimum": 1}, "expected_partition_count": {"type": "integer", "minimum": 1}}},
          "partition_manifest": {"type": "string", "minLength": 1}
        }}}}
      }}
    },
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication": {"properties": {"mode": {"const": "no_mirror"}}}}}}},
      "then": {"properties": {
        "observation_inputs": {"maxItems": 0},
        "observation_policy": {"properties": {"replication": {"properties": {
          "placements": {"maxItems": 0},
          "completeness": {"properties": {"claim": {"const": "observations_not_replicated"}, "expected_file_count": {"type": "null"}, "expected_partition_count": {"type": "null"}}},
          "partition_manifest": {"type": "null"},
          "external_locations": {"maxItems": 0}
        }}}}
      }}
    }
  ]
}
