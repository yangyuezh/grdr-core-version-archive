{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_storage_spec.schema.json",
  "title": "GRDR database snapshot storage specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_slug", "snapshot_id", "core", "source_repository", "release", "elements_root", "observation_policy", "observation_inputs", "raw_observation_exclusions", "adapter_inputs", "runtime"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "source_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repository"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"}
      }
    },
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "local_path", "visibility"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "local_path": {"type": "string", "minLength": 1},
        "visibility": {"const": "private"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "title"],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "elements_root": {"type": "string", "minLength": 1},
    "observation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replication_mode", "placements", "completeness", "partition_manifest", "external_locations", "cache"],
      "properties": {
        "replication_mode": {"enum": ["full_mirror", "partitioned_mirror", "federated_on_demand"]},
        "placements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["github_release", "elements", "object_store", "official_upstream", "research_project_cache"]}
        },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "basis", "expected_file_count", "expected_partition_count"],
          "properties": {
            "claim": {"enum": ["complete_within_knowledge_scope", "complete_declared_partition_set", "knowledge_complete_observations_federated"]},
            "basis": {"type": "string", "minLength": 1},
            "expected_file_count": {"type": ["integer", "null"], "minimum": 1},
            "expected_partition_count": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "partition_manifest": {"type": ["string", "null"], "minLength": 1},
        "external_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "uri", "local_path", "verification"],
            "properties": {
              "type": {"enum": ["object_store", "official_upstream"]},
              "uri": {"type": "string", "format": "uri"},
              "local_path": {"type": ["string", "null"]},
              "verification": {"enum": ["copied_and_hashed", "official_runtime_verified"]}
            }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "research_project_snapshots", "root"],
          "properties": {
            "mode": {"enum": ["disabled", "on_demand"]},
            "research_project_snapshots": {"type": "boolean"},
            "root": {"enum": [null, "research_project"]}
          }
        },
        "capacity_estimate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["estimated_total_bytes", "basis"],
          "properties": {
            "estimated_total_bytes": {"type": "integer", "minimum": 1},
            "basis": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "observation_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "raw_observation_exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "adapter_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "files"],
      "properties": {
        "descriptor": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication_mode": {"const": "full_mirror"}}}}},
      "then": {
        "properties": {
          "observation_inputs": {"minItems": 1},
          "observation_policy": {
            "properties": {
              "placements": {"contains": {"enum": ["github_release", "elements", "object_store"]}},
              "completeness": {
                "properties": {
                  "claim": {"const": "complete_within_knowledge_scope"},
                  "expected_file_count": {"type": "integer", "minimum": 1},
                  "expected_partition_count": {"type": "null"}
                }
              },
              "partition_manifest": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication_mode": {"const": "partitioned_mirror"}}}}},
      "then": {
        "properties": {
          "observation_inputs": {"minItems": 1},
          "observation_policy": {
            "properties": {
              "placements": {"contains": {"enum": ["github_release", "elements", "object_store"]}},
              "completeness": {
                "properties": {
                  "claim": {"const": "complete_declared_partition_set"},
                  "expected_file_count": {"type": "integer", "minimum": 1},
                  "expected_partition_count": {"type": "integer", "minimum": 1}
                }
              },
              "partition_manifest": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"observation_policy": {"properties": {"replication_mode": {"const": "federated_on_demand"}}}}},
      "then": {
        "properties": {
          "observation_inputs": {"maxItems": 0},
          "observation_policy": {
            "properties": {
              "placements": {
                "contains": {"const": "official_upstream"},
                "not": {"contains": {"enum": ["github_release", "elements", "object_store"]}}
              },
              "completeness": {
                "properties": {
                  "claim": {"const": "knowledge_complete_observations_federated"},
                  "expected_file_count": {"type": "null"},
                  "expected_partition_count": {"type": "null"}
                }
              },
              "partition_manifest": {"type": "null"}
            }
          }
        }
      }
    }
  ]
}
