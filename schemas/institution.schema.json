{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/institution.schema.json",
  "title": "GRDR institution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "institution_type",
    "primary_url",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:institution:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "institution_type": {
      "enum": [
        "intergovernmental_organization",
        "national_government_agency",
        "subnational_government_agency",
        "university_or_research_institute",
        "scientific_consortium",
        "nonprofit_organization",
        "commercial_organization",
        "archive_or_library",
        "community_project",
        "other",
        "unknown"
      ]
    },
    "jurisdiction": {"type": ["string", "null"]},
    "primary_url": {"type": "string", "format": "uri"},
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {
          "enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]
        },
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {
          "enum": ["official_homepage", "official_catalog", "official_methodology", "official_mandate", "data_paper", "peer_reviewed_validation", "license", "other"]
        },
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "archived_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
