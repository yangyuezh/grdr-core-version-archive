{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/local_cache_profile.schema.json",
  "title": "GRDR derived local snapshot-cache profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "source_id",
    "snapshot_id",
    "logical_content_fingerprint",
    "components",
    "materialized_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope": {"enum": ["agent", "full"]},
    "source_id": {"type": "string", "pattern": "^grdr:source:"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "logical_content_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "components": {
      "type": "array",
      "items": {"enum": ["agent", "knowledge", "observations"]},
      "contains": {"const": "agent"},
      "minContains": 1,
      "uniqueItems": true
    },
    "materialized_at": {"type": "string", "format": "date-time"}
  }
}
