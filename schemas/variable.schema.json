{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/variable.schema.json",
  "title": "GRDR variable record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "label", "dataset_ids", "data_structure_ids", "construct_ids", "role_candidates", "unit", "denominator", "population", "observation_unit", "spatial_resolution", "temporal_resolution", "measurement", "comparability", "join_keys", "verification", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:variable:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_native": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["system", "dataflow_id", "data_structure_id", "measure_element_id", "dimension_selections"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "dataflow_id": {"type": ["string", "null"]},
        "data_structure_id": {"type": ["string", "null"]},
        "measure_element_id": {"type": "string", "pattern": "^grdr:data-element:[a-z0-9][a-z0-9-]*$"},
        "dimension_selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element_id", "code", "label"],
            "properties": {
              "element_id": {"type": "string", "pattern": "^grdr:data-element:[a-z0-9][a-z0-9-]*$"},
              "code": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1}
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "dataset_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:dataset:[a-z0-9][a-z0-9-]*$"}, "minItems": 1, "uniqueItems": true},
    "data_structure_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:data-structure:[a-z0-9][a-z0-9-]*$"}, "minItems": 1, "uniqueItems": true},
    "construct_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:construct:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
    "role_candidates": {"type": "array", "items": {"enum": ["outcome", "exposure", "control", "confounder", "mediator", "moderator", "instrument", "selection", "validation", "context"]}, "uniqueItems": true},
    "unit": {"type": ["string", "null"]},
    "denominator": {"type": ["string", "null"]},
    "population": {"type": ["string", "null"]},
    "observation_unit": {"type": "string", "minLength": 1},
    "spatial_resolution": {"type": ["string", "null"]},
    "temporal_resolution": {"type": ["string", "null"]},
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "objective_subjective", "directness", "definition", "construction_notes"],
      "properties": {
        "type": {"enum": ["direct_observation", "self_report", "informant_report", "administrative_measure", "instrument_or_sensor_measure", "coded_or_annotated_measure", "constructed_index", "modelled_estimate", "forecast", "proxy", "latent_variable_estimate", "unknown"]},
        "objective_subjective": {"enum": ["objective", "subjective", "mixed", "not_applicable", "unknown"]},
        "directness": {"enum": ["direct", "constructed", "proxy", "unknown"]},
        "definition": {"type": ["string", "null"]},
        "construction_notes": {"type": ["string", "null"]}
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["internationally_harmonized", "harmonized_within_dataset", "partially_comparable", "not_comparable", "unknown"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "join_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {"enum": ["codebook", "official_definition", "official_methodology", "questionnaire", "standard", "data_dictionary", "peer_reviewed_validation", "other"]},
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "archived_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
