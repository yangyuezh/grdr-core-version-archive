{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_unit.schema.json",
  "title": "GRDR database deep-map work unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "sequence", "upstream_id", "label", "dataset_id", "unit_type", "disciplines", "origin_type", "structural_archetypes", "content_modalities", "lifecycle_modes", "versioning_model", "sensitivity_classes", "route_modules", "required_stages", "stages", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "id": {"type": "string", "pattern": "^grdr:deep-map-unit:[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "sequence": {"type": "integer", "minimum": 1},
    "upstream_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "dataset_id": {"type": ["string", "null"], "pattern": "^grdr:dataset:[a-z0-9][a-z0-9-]*$"},
    "unit_type": {"type": "string", "minLength": 1},
    "disciplines": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "origin_type": {"enum": ["primary", "secondary", "hybrid", "unknown"]},
    "structural_archetypes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "content_modalities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "lifecycle_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "versioning_model": {"type": "string", "minLength": 1},
    "sensitivity_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "route_modules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "minItems": 1, "uniqueItems": true},
    "required_stages": {"type": "array", "items": {"enum": ["dataset", "data_structure", "data_element", "variable", "construct", "access"]}, "minItems": 1, "uniqueItems": true},
    "stages": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "data_structure", "data_element", "variable", "construct", "access"],
      "properties": {
        "dataset": {"$ref": "#/$defs/stage"}, "data_structure": {"$ref": "#/$defs/stage"},
        "data_element": {"$ref": "#/$defs/stage"}, "variable": {"$ref": "#/$defs/stage"},
        "construct": {"$ref": "#/$defs/stage"}, "access": {"$ref": "#/$defs/stage"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {"url": {"type": "string", "format": "uri"}, "title": {"type": "string", "minLength": 1}, "evidence_type": {"type": "string", "minLength": 1}, "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "retrieved_at": {"type": "string", "format": "date-time"}}
    },
    "blocker": {
      "type": "object", "additionalProperties": false, "required": ["type", "notes"],
      "properties": {"type": {"enum": ["access", "authentication", "payment", "license", "privacy", "ethics", "technical", "scale", "missing_metadata", "other"]}, "notes": {"type": "string", "minLength": 1}}
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "expected_count", "registered_ids", "verified_count", "completion_basis", "evidence", "blockers", "notes", "updated_at"],
      "properties": {
        "state": {"enum": ["not_started", "enumerating", "in_progress", "mapped_complete", "verified_complete", "not_applicable", "blocked"]},
        "expected_count": {"type": ["integer", "null"], "minimum": 0},
        "registered_ids": {"type": "array", "items": {"type": "string", "pattern": "^grdr:[a-z-]+:[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true},
        "verified_count": {"type": "integer", "minimum": 0},
        "completion_basis": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "notes": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
