{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/source_profile.schema.json",
  "title": "GRDR six-layer source profiling record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "scope_mode",
    "scope_statement",
    "inventory_claim",
    "layer_claims",
    "enumeration",
    "blockers",
    "last_reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:source-profile:[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "scope_mode": {
      "enum": ["identity_only", "representative_chain", "question_driven", "priority_catalog", "catalog_level", "exhaustive_snapshot"]
    },
    "scope_statement": {"type": "string", "minLength": 1},
    "inventory_claim": {
      "enum": ["identity_only", "representative_only", "question_bounded", "priority_subset", "catalog_scope_complete", "exhaustive_snapshot"]
    },
    "layer_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution", "source", "dataset", "resource", "variable", "construct"],
      "properties": {
        "institution": {"$ref": "#/$defs/layer_state"},
        "source": {"$ref": "#/$defs/layer_state"},
        "dataset": {"$ref": "#/$defs/layer_state"},
        "resource": {"$ref": "#/$defs/layer_state"},
        "variable": {"$ref": "#/$defs/layer_state"},
        "construct": {"$ref": "#/$defs/layer_state"}
      }
    },
    "layer_5_details": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["data_element_claim", "variable_claim", "registered_data_element_count", "registered_variable_count", "notes"],
      "properties": {
        "data_element_claim": {"$ref": "#/$defs/layer_state"},
        "variable_claim": {"$ref": "#/$defs/layer_state"},
        "registered_data_element_count": {"type": "integer", "minimum": 0},
        "registered_variable_count": {"type": "integer", "minimum": 0},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "enumeration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "upstream_item_count", "snapshot_boundary", "notes"],
      "properties": {
        "method": {"type": ["string", "null"]},
        "upstream_item_count": {"type": ["integer", "null"], "minimum": 0},
        "snapshot_boundary": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "layer", "notes"],
        "properties": {
          "type": {"enum": ["access", "authentication", "payment", "license", "privacy", "ethics", "technical", "scale", "language", "other"]},
          "layer": {"enum": ["institution", "source", "dataset", "resource", "variable", "construct", "cross_layer"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "last_reviewed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "layer_state": {
      "enum": ["not_started", "in_progress", "representative_only", "scope_complete", "blocked"]
    }
  }
}
