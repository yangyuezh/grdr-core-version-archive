{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_intake.schema.json",
  "title": "GRDR open-world database deep-map intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "goal", "observations", "scope", "work_unit_strategy", "constraints", "explicit_route_modules", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "name", "url"],
      "properties": {
        "source_id": {"type": ["string", "null"], "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_mode", "completion_claim", "research_question"],
      "properties": {
        "scope_mode": {"enum": ["representative_chain", "question_driven", "priority_catalog", "catalog_level", "exhaustive_snapshot", "rolling_window", "bounded_partition"]},
        "completion_claim": {"enum": ["representative_only", "question_fit", "catalog_only", "bounded_partition", "exhaustive_snapshot", "rolling_current"]},
        "research_question": {"type": ["string", "null"]}
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["disciplines", "origin_types", "provenance_roles", "production_modes", "structural_archetypes", "content_modalities", "lifecycle_modes", "versioning_models", "access_regimes", "sensitivity_classes", "scale_classes", "metadata_maturity", "languages"],
      "properties": {
        "disciplines": {"$ref": "#/$defs/nonempty_strings"},
        "origin_types": {"type": "array", "items": {"enum": ["primary", "secondary", "hybrid", "unknown"]}, "minItems": 1, "uniqueItems": true},
        "provenance_roles": {"$ref": "#/$defs/nonempty_strings"},
        "production_modes": {"$ref": "#/$defs/nonempty_strings"},
        "structural_archetypes": {"$ref": "#/$defs/nonempty_strings"},
        "content_modalities": {"$ref": "#/$defs/nonempty_strings"},
        "lifecycle_modes": {"$ref": "#/$defs/nonempty_strings"},
        "versioning_models": {"$ref": "#/$defs/nonempty_strings"},
        "access_regimes": {"$ref": "#/$defs/nonempty_strings"},
        "sensitivity_classes": {"$ref": "#/$defs/nonempty_strings"},
        "scale_classes": {"$ref": "#/$defs/nonempty_strings"},
        "metadata_maturity": {"enum": ["machine_readable", "human_documented", "partial", "inferred", "undocumented", "unknown"]},
        "languages": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_type", "boundary_statement", "snapshot_at"],
      "properties": {
        "boundary_type": {"enum": ["catalog_snapshot", "release_version", "api_namespace", "collection", "question_bounded", "rolling_window", "partition_manifest", "federated_query", "other", "unknown"]},
        "boundary_statement": {"type": "string"},
        "snapshot_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "work_unit_strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_types", "identity_rule", "partition_rule", "ordering_rule", "denominator_strategy", "expected_count"],
      "properties": {
        "unit_types": {"$ref": "#/$defs/nonempty_strings"},
        "identity_rule": {"type": "string"},
        "partition_rule": {"type": "string"},
        "ordering_rule": {"type": "string"},
        "denominator_strategy": {"enum": ["explicit_count", "official_manifest", "stable_query", "version_range", "rolling_window", "partition_set", "not_enumerable", "unknown"]},
        "expected_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_access", "prohibited_actions", "compute_limit", "notes"],
      "properties": {
        "authorized_access": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "compute_limit": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "explicit_route_modules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "nonempty_strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
