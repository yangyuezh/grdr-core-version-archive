{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_storage_publication.schema.json",
  "title": "GRDR database snapshot GitHub publication record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_id", "snapshot_id", "repository_url", "release_url", "release_tag", "source_repository_commit", "assets", "verified_at", "publication_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "repository_url": {"type": "string", "format": "uri"},
    "release_url": {"type": "string", "format": "uri"},
    "release_tag": {"type": "string", "minLength": 1},
    "source_repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "assets": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/asset"}},
    "verified_at": {"type": "string", "format": "date-time"},
    "publication_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "component", "sha256", "size_bytes", "logical_paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "component": {"enum": ["manifest", "knowledge", "agent", "observations"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "logical_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
