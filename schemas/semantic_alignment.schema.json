{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/semantic_alignment.schema.json",
  "title": "GRDR persisted research-indicator semantic alignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "indicator_id", "candidate_id",
    "target_type", "target_id", "mapping_relation", "alignment_role",
    "confidence", "rationale", "indicator_evidence_unit_ids", "target_snapshot",
    "human_review_required", "review_status", "agent_provenance", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^grdr:semantic-alignment:[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "pattern": "^grdr:research-project:[a-z0-9][a-z0-9-]*$"},
    "indicator_id": {"type": "string", "pattern": "^grdr:research-indicator:[a-z0-9][a-z0-9-]*$"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^grdr:semantic-candidate:[a-z0-9][a-z0-9-]*$"},
    "target_type": {"type": ["string", "null"], "enum": ["semantic_node", "construct", null]},
    "target_id": {"type": ["string", "null"], "pattern": "^grdr:(semantic-node|construct):[a-z0-9][a-z0-9-]*$"},
    "mapping_relation": {"enum": ["exact_match", "close_match", "broader_match", "narrower_match", "related_match", "no_match"]},
    "alignment_role": {"enum": ["primary", "component", "alternative"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "indicator_evidence_unit_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^grdr:evidence-unit:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "target_snapshot": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "snapshot_id", "release"],
          "properties": {
            "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
            "snapshot_id": {"type": "string", "minLength": 1},
            "release": {"type": "string", "format": "uri"}
          }
        }
      ]
    },
    "human_review_required": {"type": "boolean"},
    "review_status": {"enum": ["agent_candidate", "human_approved", "rejected", "not_required"]},
    "agent_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "model", "method", "core_version"],
      "properties": {
        "executor": {"const": "ai_agent"},
        "model": {"type": ["string", "null"]},
        "method": {"const": "evidence_constrained_semantic_alignment"},
        "core_version": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
