{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_check.schema.json",
  "title": "GRDR route-contract completion check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "unit_id", "route_modules", "facet_id", "scope", "stage", "requirement", "required", "state", "completion_basis", "evidence", "blockers", "notes", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^grdr:deep-map-check:[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "unit_id": {"type": ["string", "null"], "pattern": "^grdr:deep-map-unit:[a-z0-9][a-z0-9-]*$"},
    "route_modules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "minItems": 1, "uniqueItems": true},
    "facet_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "scope": {"enum": ["project", "unit"]},
    "stage": {"enum": ["project", "dataset", "data_structure", "data_element", "variable", "construct", "access"]},
    "requirement": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "state": {"enum": ["not_started", "in_progress", "passed", "not_applicable", "blocked", "failed", "needs_human_review"]},
    "completion_basis": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "notes": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"}, "title": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "scope", "recoverability", "resolution", "notes"],
      "properties": {
        "type": {"enum": ["identity", "boundary", "access", "authentication", "payment", "license", "privacy", "ethics", "security", "technical", "format", "scale", "rate_limit", "schema_drift", "version_drift", "missing_metadata", "semantic_ambiguity", "quality", "human_decision", "other"]},
        "scope": {"enum": ["project", "unit", "stage", "item"]},
        "recoverability": {"enum": ["retryable", "alternative_route", "requires_authorization", "requires_human_decision", "upstream_only", "unknown"]},
        "resolution": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
