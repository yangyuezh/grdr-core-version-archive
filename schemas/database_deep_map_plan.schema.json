{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_deep_map_plan.schema.json",
  "title": "GRDR open-world database deep-map execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_contract_version", "source", "goal", "diagnostic_dimensions", "scope", "work_unit_strategy", "selected_route_modules", "required_facets", "unresolved_critical", "human_gates", "risk_flags", "fallback_policy", "plan_status", "evidence", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "route_contract_version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "name", "url"],
      "properties": {
        "source_id": {"type": ["string", "null"], "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_mode", "completion_claim", "research_question"],
      "properties": {
        "scope_mode": {"enum": ["representative_chain", "question_driven", "priority_catalog", "catalog_level", "exhaustive_snapshot", "rolling_window", "bounded_partition"]},
        "completion_claim": {"enum": ["representative_only", "question_fit", "catalog_only", "bounded_partition", "exhaustive_snapshot", "rolling_current"]},
        "research_question": {"type": ["string", "null"]}
      }
    },
    "diagnostic_dimensions": {
      "type": "object", "additionalProperties": false,
      "required": ["disciplines", "origin_types", "provenance_roles", "production_modes", "structural_archetypes", "content_modalities", "lifecycle_modes", "versioning_models", "access_regimes", "sensitivity_classes", "scale_classes", "metadata_maturity", "languages"],
      "properties": {
        "disciplines": {"$ref": "#/$defs/nonempty_strings"},
        "origin_types": {"$ref": "#/$defs/nonempty_strings"},
        "provenance_roles": {"$ref": "#/$defs/nonempty_strings"},
        "production_modes": {"$ref": "#/$defs/nonempty_strings"},
        "structural_archetypes": {"$ref": "#/$defs/nonempty_strings"},
        "content_modalities": {"$ref": "#/$defs/nonempty_strings"},
        "lifecycle_modes": {"$ref": "#/$defs/nonempty_strings"},
        "versioning_models": {"$ref": "#/$defs/nonempty_strings"},
        "access_regimes": {"$ref": "#/$defs/nonempty_strings"},
        "sensitivity_classes": {"$ref": "#/$defs/nonempty_strings"},
        "scale_classes": {"$ref": "#/$defs/nonempty_strings"},
        "metadata_maturity": {"enum": ["machine_readable", "human_documented", "partial", "inferred", "undocumented", "unknown"]},
        "languages": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_type", "boundary_statement", "snapshot_at"],
      "properties": {
        "boundary_type": {"enum": ["catalog_snapshot", "release_version", "api_namespace", "collection", "question_bounded", "rolling_window", "partition_manifest", "federated_query", "other", "unknown"]},
        "boundary_statement": {"type": "string"},
        "snapshot_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "work_unit_strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_types", "identity_rule", "partition_rule", "ordering_rule", "denominator_strategy", "expected_count"],
      "properties": {
        "unit_types": {"$ref": "#/$defs/nonempty_strings"},
        "identity_rule": {"type": "string"},
        "partition_rule": {"type": "string"},
        "ordering_rule": {"type": "string"},
        "denominator_strategy": {"enum": ["explicit_count", "official_manifest", "stable_query", "version_range", "rolling_window", "partition_set", "not_enumerable", "unknown"]},
        "expected_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "selected_route_modules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "minItems": 1, "uniqueItems": true},
    "required_facets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scope", "stage", "requirement", "completion_evidence", "source_routes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "scope": {"enum": ["project", "unit"]},
          "stage": {"enum": ["project", "dataset", "data_structure", "data_element", "variable", "construct", "access"]},
          "requirement": {"type": "string", "minLength": 1},
          "completion_evidence": {"type": "string", "minLength": 1},
          "source_routes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "unresolved_critical": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate", "reason", "required_before", "status", "reviewer", "decided_at", "notes"],
        "properties": {
          "gate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "reason": {"type": "string", "minLength": 1},
          "required_before": {"enum": ["metadata_access", "observation_access", "local_storage", "semantic_promotion", "publication"]},
          "status": {"enum": ["pending", "approved", "rejected", "not_applicable"]},
          "reviewer": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"], "format": "date-time"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "risk_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fallback_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["unknown_structure", "access_failure", "scale", "change", "semantic_ambiguity"],
      "properties": {
        "unknown_structure": {"type": "string", "minLength": 1},
        "access_failure": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "change": {"type": "string", "minLength": 1},
        "semantic_ambiguity": {"type": "string", "minLength": 1}
      }
    },
    "plan_status": {"enum": ["ready", "ready_with_gates", "needs_evidence", "blocked"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "nonempty_strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "supports": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
