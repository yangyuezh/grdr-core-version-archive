{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/monitor.schema.json",
  "title": "GRDR upstream monitor record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "target_id", "check_types", "interval_days", "enabled", "implementation", "state", "verification", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:monitor:[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "pattern": "^grdr:(source|dataset|resource|adapter):[a-z0-9][a-z0-9-]*$"},
    "check_types": {"type": "array", "items": {"enum": ["reachability", "response_shape", "release", "metadata", "methodology", "license", "url_migration", "deprecation", "other"]}, "minItems": 1, "uniqueItems": true},
    "interval_days": {"type": "integer", "minimum": 1},
    "enabled": {"type": "boolean"},
    "implementation": {"type": "string", "minLength": 1},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_checked_at", "next_due_at", "last_message"],
      "properties": {
        "status": {"enum": ["passing", "changed", "degraded", "failing", "never_run", "disabled"]},
        "last_checked_at": {"type": ["string", "null"], "format": "date-time"},
        "next_due_at": {"type": ["string", "null"], "format": "date-time"},
        "last_message": {"type": ["string", "null"]}
      }
    },
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {"enum": ["api_documentation", "live_test", "monitor_log", "other"]},
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
