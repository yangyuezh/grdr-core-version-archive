{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_route_contracts.schema.json",
  "title": "GRDR extensible database route contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "route_modules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"type": "string", "minLength": 1},
    "route_modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "description", "triggers", "facets", "recommended_tools", "standards", "fallback_routes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "trigger_mode": {"enum": ["any_signal", "structural_only"]},
          "triggers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
          "facets": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "scope", "stage", "requirement", "completion_evidence"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
                "scope": {"enum": ["project", "unit"]},
                "stage": {"enum": ["project", "dataset", "data_structure", "data_element", "variable", "construct", "access"]},
                "requirement": {"type": "string", "minLength": 1},
                "completion_evidence": {"type": "string", "minLength": 1}
              }
            }
          },
          "recommended_tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "standards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "url"],
              "properties": {
                "name": {"type": "string"},
                "url": {"type": "string", "format": "uri"}
              },
              "additionalProperties": false
            }
          },
          "fallback_routes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true}
        }
      }
    }
  }
}
