{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/database_storage_package.schema.json",
  "title": "GRDR materialized database snapshot package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "source_id", "source_slug", "snapshot_id", "core_version", "core_repository", "source_repository", "source_repository_path", "release_tag", "release_title", "release_assets_path", "canonical_archive_fingerprint", "knowledge_file_count", "observation_file_count", "logical_file_count", "logical_size_bytes", "logical_files", "release_assets", "runtime", "runtime_audit", "logical_content_fingerprint", "prepared_at", "package_fingerprint"],
  "properties": {
    "schema_version": {"enum": ["2.0.0", "3.0.0", "4.0.0", "4.1.0"]},
    "project_id": {"type": "string", "pattern": "^grdr:deep-map-project:[a-z0-9][a-z0-9-]*$"},
    "source_id": {"type": "string", "pattern": "^grdr:source:[a-z0-9][a-z0-9-]*$"},
    "source_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "core_version": {"type": "string", "minLength": 1},
    "core_repository": {"type": "string", "format": "uri"},
    "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "source_repository_path": {"type": "string", "minLength": 1},
    "release_tag": {"type": "string", "minLength": 1},
    "release_title": {"type": "string", "minLength": 1},
    "release_assets_path": {"type": "string", "minLength": 1},
    "elements_snapshot_path": {"type": "string", "minLength": 1},
    "local_snapshot_cache_path": {"type": "string", "minLength": 1},
    "canonical_archive_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "project_scope_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_profile": {"$ref": "#/$defs/snapshot_profile"},
    "knowledge_file_count": {"type": "integer", "minimum": 1},
    "observation_file_count": {"type": "integer", "minimum": 0},
    "logical_file_count": {"type": "integer", "minimum": 2},
    "logical_size_bytes": {"type": "integer", "minimum": 1},
    "logical_files": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/file"}},
    "release_assets": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/asset"}},
    "external_observation_locations": {"type": "array", "items": {"$ref": "#/$defs/external_location"}},
    "runtime": {"$ref": "#/$defs/runtime"},
    "runtime_audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "status", "variable_count", "resolvable_variable_count", "unresolved_variable_count"],
      "properties": {
        "source_id": {"type": "string"},
        "status": {"const": "ready"},
        "variable_count": {"type": "integer", "minimum": 0},
        "resolvable_variable_count": {"type": "integer", "minimum": 0},
        "unresolved_variable_count": {"const": 0}
      }
    },
    "online_access_manifest": {"$ref": "#/$defs/online_access"},
    "online_runtime_audit": {"$ref": "#/$defs/online_runtime_audit"},
    "invocation_acceptance_audit": {"$ref": "#/$defs/invocation_acceptance_audit"},
    "knowledge_content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation_content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "duplicate_content_hash_count": {"const": 0},
    "logical_content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "package_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0.0"}}},
      "then": {
        "properties": {
          "observation_file_count": {"minimum": 1},
          "logical_file_count": {"minimum": 3},
          "logical_files": {"minItems": 3},
          "release_assets": {"minItems": 3}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "3.0.0"}}},
      "then": {
        "required": ["project_scope_fingerprint", "snapshot_profile", "external_observation_locations", "knowledge_content_fingerprint", "observation_content_fingerprint", "duplicate_content_hash_count"]
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "4.0.0"}}},
      "then": {
        "required": ["elements_snapshot_path"],
        "properties": {
          "snapshot_profile": {"required": ["online_access"]},
          "runtime": {
            "required": ["route_environment_protocol", "online_access_manifest", "supported_access_methods"],
            "properties": {
              "schema_version": {"const": "2.0.0"},
              "protocol_version": {"const": "grdr-source-runtime/2.0"},
              "operations": {"contains": {"const": "self-test-online"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "4.1.0"}}},
      "then": {
        "required": ["project_scope_fingerprint", "snapshot_profile", "external_observation_locations", "online_access_manifest", "online_runtime_audit", "knowledge_content_fingerprint", "observation_content_fingerprint", "duplicate_content_hash_count"],
        "properties": {
          "snapshot_profile": {"required": ["online_access"]},
          "runtime": {
            "required": ["route_environment_protocol", "online_access_manifest", "supported_access_methods"],
            "properties": {
              "schema_version": {"const": "2.0.0"},
              "protocol_version": {"const": "grdr-source-runtime/2.0"},
              "operations": {"contains": {"const": "self-test-online"}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "snapshot_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_scope", "observation_replication", "observation_placement"],
      "properties": {
        "knowledge_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "completion_claim", "boundary_type", "boundary_statement", "snapshot_at", "scope_fingerprint", "inherited_from_plan"],
          "properties": {
            "mode": {"type": "string", "minLength": 1},
            "completion_claim": {"type": "string", "minLength": 1},
            "boundary_type": {"type": "string", "minLength": 1},
            "boundary_statement": {"type": "string", "minLength": 1},
            "snapshot_at": {"type": "string", "format": "date-time"},
            "scope_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "inherited_from_plan": {"const": true}
          }
        },
        "observation_replication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "completeness_claim", "completeness_basis", "expected_file_count", "actual_file_count", "expected_partition_count", "actual_partition_count", "partition_manifest"],
          "properties": {
            "mode": {"enum": ["full_mirror", "partitioned_mirror", "federated_on_demand", "no_mirror"]},
            "completeness_claim": {"enum": ["complete_within_knowledge_scope", "complete_declared_partition_set", "knowledge_complete_observations_federated", "observations_not_replicated"]},
            "completeness_basis": {"type": "string", "minLength": 1},
            "expected_file_count": {"type": ["integer", "null"], "minimum": 1},
            "actual_file_count": {"type": "integer", "minimum": 0},
            "expected_partition_count": {"type": ["integer", "null"], "minimum": 1},
            "actual_partition_count": {"type": "integer", "minimum": 0},
            "partition_manifest": {"type": ["object", "null"]}
          }
        },
        "online_access": {"$ref": "#/$defs/online_access_profile"},
        "observation_placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locations", "cache"],
          "properties": {
            "locations": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["github_release", "elements", "object_store", "official_upstream", "research_project_cache"]}
            },
            "cache": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "research_project_snapshots", "root"],
              "properties": {
                "mode": {"enum": ["disabled", "on_demand"]},
                "research_project_snapshots": {"type": "boolean"},
                "root": {"enum": [null, "research_project"]}
              }
            }
          }
        },
        "capacity_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_source", "estimated_total_bytes", "estimate_basis", "captured_bytes", "size_class", "github_release_observation_max_bytes", "github_release_asset_max_bytes", "selected_mode", "selected_placements", "recommendation", "policy_compliant"],
          "properties": {
            "policy_source": {"type": "string", "minLength": 1},
            "estimated_total_bytes": {"type": ["integer", "null"], "minimum": 0},
            "estimate_basis": {"type": "string", "minLength": 1},
            "captured_bytes": {"type": "integer", "minimum": 0},
            "size_class": {"enum": ["small", "medium", "large", "unknown"]},
            "github_release_observation_max_bytes": {"type": "integer", "minimum": 1},
            "elements_full_mirror_max_bytes": {"type": "integer", "minimum": 1},
            "github_release_asset_max_bytes": {"type": "integer", "minimum": 1},
            "selected_mode": {"enum": ["full_mirror", "partitioned_mirror", "federated_on_demand", "no_mirror"]},
            "selected_placements": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["github_release", "elements", "object_store", "official_upstream", "research_project_cache"]}
            },
            "recommendation": {"type": "string", "minLength": 1},
            "policy_compliant": {"const": true}
          }
        }
      }
    },
    "online_access_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "official_access_status", "official_access_basis", "route_count", "expected_variable_count", "online_callable_variable_count", "unresolved_online_variable_count", "routes", "route_policies"],
      "properties": {
        "status": {"const": "callable_complete"},
        "official_access_status": {"enum": ["callable", "unavailable"]},
        "official_access_basis": {"type": "string", "minLength": 1},
        "route_count": {"type": "integer", "minimum": 1},
        "expected_variable_count": {"type": "integer", "minimum": 0},
        "online_callable_variable_count": {"type": "integer", "minimum": 0},
        "unresolved_online_variable_count": {"const": 0},
        "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/online_route"}},
        "route_policies": {"$ref": "#/$defs/route_policies"}
      }
    },
    "online_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "access_method", "authority", "uri", "freshness", "coverage_claim", "verification"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "access_method": {"enum": ["official_api", "official_bulk_download", "official_browser_automation", "grdr_release_snapshot"]},
        "authority": {"enum": ["official", "grdr"]},
        "uri": {"type": "string", "format": "uri"},
        "freshness": {"enum": ["current_upstream", "version_pinned", "frozen_snapshot"]},
        "coverage_claim": {"enum": ["all_registered_variables", "declared_subset"]},
        "verification": {"enum": ["live_runtime_test", "staged_release_snapshot_test"]}
      }
    },
    "route_class": {"type": "string", "enum": ["official_online", "github_release_snapshot", "local_snapshot_cache", "elements_mirror", "mounted_object_store"]},
    "route_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest", "reproducible", "offline"],
      "properties": {
        "latest": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/route_class"}},
        "reproducible": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/route_class"}},
        "offline": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/route_class"}}
      }
    },
    "online_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_id", "snapshot_id", "status", "completion_requirement", "official_access", "routes", "coverage", "route_policies"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source_id": {"type": "string"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "status": {"const": "callable_complete"},
        "completion_requirement": {"const": "all_registered_variables_online_callable"},
        "official_access": {
          "type": "object", "additionalProperties": false, "required": ["status", "basis"],
          "properties": {"status": {"enum": ["callable", "unavailable"]}, "basis": {"type": "string", "minLength": 1}}
        },
        "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/online_route"}},
        "coverage": {
          "type": "object", "additionalProperties": false, "required": ["claim", "expected_variable_count"],
          "properties": {"claim": {"const": "all_registered_variables"}, "expected_variable_count": {"type": "integer", "minimum": 0}}
        },
        "route_policies": {"$ref": "#/$defs/route_policies"}
      }
    },
    "online_runtime_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_id", "snapshot_id", "status", "variable_count", "online_callable_variable_count", "unresolved_online_variable_count", "route_results", "variable_routes", "tested_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source_id": {"type": "string"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "status": {"const": "ready"},
        "variable_count": {"type": "integer", "minimum": 0},
        "online_callable_variable_count": {"type": "integer", "minimum": 0},
        "unresolved_online_variable_count": {"const": 0},
        "route_results": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["route_id", "status", "access_method", "authority", "tested_at", "evidence_basis"],
            "properties": {
              "route_id": {"type": "string"}, "status": {"const": "ready"},
              "access_method": {"enum": ["official_api", "official_bulk_download", "official_browser_automation", "grdr_release_snapshot"]},
              "authority": {"enum": ["official", "grdr"]},
              "tested_at": {"type": "string", "format": "date-time"},
              "evidence_basis": {"type": "string", "minLength": 1}
            }
          }
        },
        "variable_routes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["variable_id", "route_ids"],
            "properties": {"variable_id": {"type": "string"}, "route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
          }
        },
        "tested_at": {"type": "string", "format": "date-time"}
      }
    },
    "invocation_acceptance_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_id", "snapshot_id", "status", "registered_variable_count", "probe_count", "probes", "tested_at"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "source_id": {"type": "string"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "status": {"const": "ready"},
        "registered_variable_count": {"type": "integer", "minimum": 0},
        "probe_count": {"type": "integer", "minimum": 0},
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probe_id", "variable_id", "route_policy", "parameters", "selected_route", "selected_route_id", "row_count", "output_file_count", "output_content_fingerprint", "status"],
            "properties": {
              "probe_id": {"type": "string"},
              "variable_id": {"type": "string"},
              "route_policy": {"enum": ["latest", "reproducible", "offline"]},
              "parameters": {"type": "object"},
              "selected_route": {"type": "string"},
              "selected_route_id": {"type": "string"},
              "row_count": {"type": "integer", "minimum": 0},
              "output_file_count": {"type": "integer", "minimum": 1},
              "output_content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "status": {"const": "passed"}
            }
          }
        },
        "tested_at": {"type": "string", "format": "date-time"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol_version", "source_id", "entrypoint", "agent_index", "operations", "official_domains"],
      "properties": {
        "schema_version": {"enum": ["1.0.0", "2.0.0"]},
        "protocol_version": {"enum": ["grdr-source-runtime/1.0", "grdr-source-runtime/2.0"]},
        "route_environment_protocol": {"const": "grdr-route-context/1.0"},
        "source_id": {"type": "string"},
        "entrypoint": {"type": "string"},
        "agent_index": {"const": "grdr-agent-index.sqlite"},
        "online_access_manifest": {"const": "online_access.json"},
        "operations": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["self-test", "self-test-online", "search", "resolve-variable", "fetch-variable"]},
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "self-test"}},
            {"contains": {"const": "search"}},
            {"contains": {"const": "resolve-variable"}},
            {"contains": {"const": "fetch-variable"}}
          ]
        },
        "supported_access_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["official_api", "official_bulk_download", "official_browser_automation", "grdr_release_snapshot"]}
        },
        "official_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": ["string", "null"]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "component", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "component": {"enum": ["knowledge", "agent", "observations"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["github_release", "elements", "object_store"]}
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "component", "sha256", "size_bytes", "logical_paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "component": {"enum": ["manifest", "knowledge", "agent", "observations"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "logical_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "external_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "local_path", "verification", "logical_paths", "content_fingerprint"],
      "properties": {
        "type": {"enum": ["object_store", "official_upstream"]},
        "uri": {"type": "string", "format": "uri"},
        "local_path": {"type": ["string", "null"]},
        "verification": {"enum": ["copied_and_hashed", "official_runtime_verified"]},
        "logical_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
