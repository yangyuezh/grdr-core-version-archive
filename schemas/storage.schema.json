{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/storage.schema.json",
  "title": "GRDR access and storage record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "dataset_id", "resource_id", "mode", "upstream_release", "local_snapshot", "access_pointer", "refresh", "license", "verification", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:storage:[a-z0-9][a-z0-9-]*$"},
    "dataset_id": {"type": "string", "pattern": "^grdr:dataset:[a-z0-9][a-z0-9-]*$"},
    "resource_id": {"type": "string", "pattern": "^grdr:resource:[a-z0-9][a-z0-9-]*$"},
    "mode": {"enum": ["local_snapshot", "federated_access", "controlled_access_pointer"]},
    "upstream_release": {"type": ["string", "null"]},
    "local_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "checksum_algorithm": {"type": "string"},
        "checksum": {"type": "string"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "row_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "access_pointer": {"type": ["string", "null"], "format": "uri"},
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "last_refreshed_at", "next_due_at"],
      "properties": {
        "strategy": {"enum": ["manual", "scheduled", "on_demand", "upstream_event", "unknown"]},
        "last_refreshed_at": {"type": ["string", "null"], "format": "date-time"},
        "next_due_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "allows_local_copy", "notes"],
      "properties": {
        "status": {"enum": ["documented_open", "documented_restricted", "custom_or_mixed", "unknown"]},
        "allows_local_copy": {"type": ["boolean", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "verification": {"$ref": "#/$defs/verification"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "evidence_type": {"enum": ["access_policy", "license", "api_documentation", "live_test", "other"]},
        "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
