{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/indicator_project.schema.json",
  "title": "GRDR research indicator project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "research_question", "evidence_stage", "analysis_methods", "corpus_protocol", "human_gates", "agent_provenance", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:research-project:[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "evidence_stage": {"enum": ["topic_scaffold", "corpus_declared", "evidence_extracted", "indicator_synthesized", "human_reviewed", "mapping_ready"]},
    "analysis_methods": {
      "type": "array",
      "items": {"enum": ["theory_deduction", "content_analysis", "grounded_theory", "thematic_synthesis", "systematic_review", "mixed"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "corpus_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_strategy", "sources", "inclusion_criteria", "exclusion_criteria", "date_boundary", "languages", "saturation_rule"],
      "properties": {
        "search_strategy": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "inclusion_criteria": {"type": "array", "items": {"type": "string"}},
        "exclusion_criteria": {"type": "array", "items": {"type": "string"}},
        "date_boundary": {"type": ["string", "null"]},
        "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "saturation_rule": {"type": ["string", "null"]}
      }
    },
    "human_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_boundary", "indicator_framework", "contested_mappings"],
      "properties": {
        "corpus_boundary": {"$ref": "#/$defs/gate"},
        "indicator_framework": {"$ref": "#/$defs/gate"},
        "contested_mappings": {"$ref": "#/$defs/gate"}
      }
    },
    "agent_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "model", "workflow_version"],
      "properties": {
        "executor": {"enum": ["ai_agent", "human", "hybrid"]},
        "model": {"type": ["string", "null"]},
        "workflow_version": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["pending", "approved", "not_required", "exploratory_only"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
