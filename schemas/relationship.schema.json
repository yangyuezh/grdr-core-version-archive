{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/relationship.schema.json",
  "title": "GRDR relationship record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "subject_id", "predicate", "object_id", "verification", "evidence"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:relationship:[a-z0-9][a-z0-9-]*$"},
    "subject_id": {"type": "string", "pattern": "^grdr:(institution|source|dataset|data-structure|resource|data-element|variable|construct|semantic-node|adapter|storage|monitor):"},
    "predicate": {
      "enum": [
        "produced_by",
        "maintained_by",
        "published_by",
        "funded_by",
        "governed_by",
        "contains",
        "organized_as",
        "defines",
        "derived_from",
        "harmonizes",
        "mirrors",
        "supersedes",
        "replaced_by",
        "documents",
        "measures",
        "proxy_for",
        "classified_as",
        "broader_than",
        "narrower_than",
        "describes",
        "observes",
        "has_population",
        "has_observation_unit",
        "has_analysis_unit",
        "operationalizes",
        "joinable_with",
        "complements",
        "overlaps_with",
        "cites",
        "accessed_via",
        "stored_as",
        "monitored_by"
      ]
    },
    "object_id": {"type": "string", "pattern": "^grdr:(institution|source|dataset|data-structure|resource|data-element|variable|construct|semantic-node|adapter|storage|monitor):"},
    "qualifiers": {"type": "object"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_verified_at"],
      "properties": {
        "status": {"enum": ["unverified", "partially_verified", "verified", "stale", "conflicted", "deprecated", "unavailable"]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "evidence_type", "supports", "retrieved_at"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "evidence_type": {"type": "string"},
          "supports": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
