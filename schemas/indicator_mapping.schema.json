{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grdr.dev/schemas/indicator_mapping.schema.json",
  "title": "GRDR research-indicator to registry-variable mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "indicator_id", "mapping_status", "variable_ids", "transformation", "fit", "human_review_required", "review_status", "notes"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^grdr:indicator-mapping:[a-z0-9][a-z0-9-]*$"},
    "project_id": {"type": "string", "pattern": "^grdr:research-project:[a-z0-9][a-z0-9-]*$"},
    "indicator_id": {"type": "string", "pattern": "^grdr:research-indicator:[a-z0-9][a-z0-9-]*$"},
    "mapping_status": {"enum": ["direct_match", "transform_required", "composite_required", "proxy_candidate", "definition_conflict", "not_found_registry_snapshot"]},
    "variable_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^grdr:variable:[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "transformation": {"type": ["string", "null"]},
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construct", "population", "unit", "time", "space"],
      "properties": {
        "construct": {"$ref": "#/$defs/fit"},
        "population": {"$ref": "#/$defs/fit"},
        "unit": {"$ref": "#/$defs/fit"},
        "time": {"$ref": "#/$defs/fit"},
        "space": {"$ref": "#/$defs/fit"}
      }
    },
    "human_review_required": {"type": "boolean"},
    "review_status": {"enum": ["agent_candidate", "human_approved", "rejected", "not_required"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "fit": {"enum": ["exact", "partial", "incompatible", "unknown"]}
  }
}
